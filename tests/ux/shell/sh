#!/bin/sh
# Parity-only wrapper. Ordinary shell commands remain unchanged. A native test
# turn can wait for a release file while Playwright exercises the real queue.
case "${GI_PROMPT-}" in
  'UX queue gate:'*)
    token=${GI_PROMPT#UX queue gate:}
    case "$token" in ''|*[!a-zA-Z0-9_-]*) exec /bin/sh "$@";; esac
    if [ -n "${GI_UX_QUEUE_GATES-}" ]; then
      # Actual stdout preview lets disconnect acceptance observe stream clearing.
      printf 'Queue gate streaming preview\n'
      count=0
      while [ ! -f "$GI_UX_QUEUE_GATES/$token" ] && [ "$count" -lt 600 ]; do
        /bin/sleep 0.1
        count=$((count+1))
      done
    fi
    ;;
esac
case "${GI_PROMPT-}" in
  'UX tool fail:'*) printf 'native tool fixture failure\n' >&2; exit 7 ;;
esac
exec /bin/sh "$@"
